# CEUR-Graph configuration template.
# Copy to `.env` and fill in / override values. All variables are read
# by pydantic-settings at startup (prefix: CEUR_GRAPH_).

# --- Wikibase endpoints (override to target a different Wikibase instance) ---
CEUR_GRAPH_WIKIBASE_WEBSITE=https://ceur-dev.wikibase.cloud/
CEUR_GRAPH_WIKIBASE_SPARQL_ENDPOINT=https://ceur-dev.wikibase.cloud/query/sparql
CEUR_GRAPH_WIKIBASE_ITEM_PREFIX=https://ceur-dev.wikibase.cloud/entity/
CEUR_GRAPH_WIKIBASE_PROPERTY_PREFIX=https://ceur-dev.wikibase.cloud/prop/direct/
CEUR_GRAPH_WIKIBASE_MEDIAWIKI_API_URL=https://ceur-dev.wikibase.cloud/w/api.php
CEUR_GRAPH_WIKIBASE_MEDIAWIKI_REST_URL=https://ceur-dev.wikibase.cloud/w/rest.php

# --- Schema (LinkML schema driving model + router codegen) ---
# Path to the LinkML schema YAML the app loads at startup. Defaults to the
# bundled `ceur_graph.yaml`. To deploy with a different schema, point this
# at the alternative file (in Docker, bind-mount it and set this to the
# in-container path).
# CEUR_GRAPH_SCHEMA_PATH=/app/src/ceur_graph/schema/ceur_graph.yaml

# --- OAuth 2.0 consumer (register at <wikibase>/wiki/Special:OAuthConsumerRegistration/propose) ---
CEUR_GRAPH_OAUTH_CLIENT_ID=
CEUR_GRAPH_OAUTH_CLIENT_SECRET=
CEUR_GRAPH_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/callback

# --- App ---
CEUR_GRAPH_APP_BASE_URL=http://localhost:8000/
CEUR_GRAPH_SESSION_TTL_MINUTES=60
